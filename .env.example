# Copy to .env.local for local development. Render Static Site:
# add both VITE_ variables in Environment settings, then redeploy.
# Use the project's *publishable* key (sb_publishable_...), never secret/service_role.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
